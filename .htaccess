RewriteEngine On

# Handle language routes - must come before other rules
RewriteRule ^en/?$ en.html [L,QSA]
RewriteRule ^sr/?$ sr.html [L,QSA]

# Serbian homepage (root)
RewriteRule ^$ index.html [L,QSA]

# Let static files pass through (images, fonts, CSS, JS, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Let directories pass through
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else → index.html (for client-side routing fallback)
RewriteRule ^ index.html [L]

